{
  "name": "backend-edumon",
  "version": "1.0.0",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "seed": "node src/scripts/seed.js",
    "correos:prueba": "node src/scripts/enviarCorreosDePrueba.js",
    "fotos:subir": "node src/scripts/subirFotosPredeterminadas.js",
    "telefonos:normalizar": "node src/scripts/normalizarTelefonos.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "edumon",
    "educacion",
    "colegio",
    "api-rest",
    "express",
    "mongodb"
  ],
  "author": "Bryan David Yepes",
  "license": "SEE LICENSE IN README.md",
  "description": "Backend (API REST) de Edumon, plataforma de gestion escolar para instituciones, docentes y padres/acudientes.",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "compression": "^1.8.1",
    "connect-timeout": "^1.9.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.2",
    "express-validator": "^7.2.1",
    "firebase-admin": "^13.8.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.18.1",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.1.0",
    "socket.io": "^4.8.1",
    "twilio": "^5.10.3"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.11",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.10",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2",
    "vitest": "^4.1.11"
  }
}
