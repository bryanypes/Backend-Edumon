# Copia este archivo como ".env" y completa cada valor.
# Entorno
NODE_ENV=development
PORT=4000

# Origen(es) permitidos por CORS en producción, separados por coma si hay varios (en dev, CORS va abierto)
FRONTEND_URL=https://edumon-web.vercel.app,https://edumon-flutter-web.example.com

# Base de datos
# Cadena de conexión de MongoDB (local o Atlas)
MONGO_URI=mongodb://localhost:27017/edumon

# Autenticación (JWT)
# Secreto para firmar los access tokens. Usa un valor largo y aleatorio
# (ej. `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`)
JWT_SECRET=

# Almacenamiento local de archivos (fotos, adjuntos, APK).
# En Docker se monta un volumen persistente en esta ruta. Por defecto ./uploads
UPLOAD_DIR=

# Firebase Admin SDK (notificaciones push / FCM)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Debe incluir los \n literales de la clave privada entre comillas, ej:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# SMTP (recuperación de contraseña y notificaciones por correo)
# Servidor de correo de la universidad (u otro proveedor SMTP)
SMTP_HOST=
SMTP_PORT=587
# true = SSL directo (puerto 465). false = STARTTLS (puerto 587/25, lo más común)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Edumon
# Si se omite, se usa SMTP_USER como remitente
SMTP_FROM_EMAIL=

# Institución del piloto: se crea automáticamente al arrancar, solo si no
# existe ya (por NIT). Los BOOTSTRAP_ADMIN_* con ROL=administrador quedan
# asignados a ella; los ROL=superadmin no la necesitan. Deja NOMBRE vacío
# para no crear ninguna (los administradores quedarían sin institución).
BOOTSTRAP_INSTITUCION_NOMBRE=
BOOTSTRAP_INSTITUCION_NIT=
BOOTSTRAP_INSTITUCION_DIRECCION=
BOOTSTRAP_INSTITUCION_TELEFONO=
BOOTSTRAP_INSTITUCION_CORREO=

# Superadmins iniciales del piloto: se crean automáticamente al arrancar el
# backend, SOLO si todavía no existen (por cédula o teléfono) — es seguro
# reiniciar el contenedor, nunca se pisan ni se borran. No dejes vacía ninguna
# de las 5 obligatorias (NOMBRE, APELLIDO, CEDULA, TELEFONO, PASSWORD) o esa
# cuenta se omite. Deja todo el bloque vacío si no quieres crear ninguna.
# La contraseña es temporal: al primer login se obliga a cambiarla.
# Se pueden agregar más (BOOTSTRAP_ADMIN_3_*, _4_*, ...); se leen en orden
# hasta el primer número sin TELEFONO configurado.
BOOTSTRAP_ADMIN_1_NOMBRE=
BOOTSTRAP_ADMIN_1_APELLIDO=
BOOTSTRAP_ADMIN_1_CEDULA=
BOOTSTRAP_ADMIN_1_CORREO=
# formato colombiano: 10 dígitos (con o sin +57)
BOOTSTRAP_ADMIN_1_TELEFONO=
BOOTSTRAP_ADMIN_1_PASSWORD=
# opcional, por defecto "superadmin" (administrador global, sin institución
# asignada — puede crear la institución y las demás cuentas desde la app)
BOOTSTRAP_ADMIN_1_ROL=superadmin

BOOTSTRAP_ADMIN_2_NOMBRE=
BOOTSTRAP_ADMIN_2_APELLIDO=
BOOTSTRAP_ADMIN_2_CEDULA=
BOOTSTRAP_ADMIN_2_CORREO=
BOOTSTRAP_ADMIN_2_TELEFONO=
BOOTSTRAP_ADMIN_2_PASSWORD=
BOOTSTRAP_ADMIN_2_ROL=superadmin

# IA Edumon. Sin ninguna llave, Edumon funciona en modo simulado (reglas + fichas).
# Un proveedor sin llave se omite sin error.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Opcional: URL base de un proxy o servidor compatible con la API de OpenAI
# (vacío = API oficial). Se usa en el ensayo de la demo con un proveedor local.
GROQ_BASE_URL=
OPENAI_BASE_URL=
# Orden de los proveedores (el primero responde; los demás son respaldo).
# Cambiarlo solo requiere reiniciar, ej. "openai,groq".
LLM_PROVIDER_ORDER=groq,openai
# Tiempo máximo por llamada antes de pasar al siguiente proveedor (ms)
LLM_TIMEOUT_MS=20000
# Tras un 429 o una llave inválida (401), el proveedor se salta durante estos segundos
LLM_COOLDOWN_SECONDS=60
# Caché de clasificaciones del LLM (mensaje normalizado + contexto), en segundos
LLM_CACHE_TTL_SECONDS=600
# Límite por usuario en los endpoints de /api/ia que llaman a la IA
IA_RATE_LIMIT_MAX=20
IA_RATE_LIMIT_WINDOW_SECONDS=60
# Plazos de atención de alertas para las métricas de impacto (horas; pendientes de validación por convivencia)
IA_PLAZO_ATENCION_HORAS_GRAVE=24
IA_PLAZO_ATENCION_HORAS_MODERADO=72
# Tabla de precios de IA (por defecto src/config/preciosIA.json, con fuente y fecha oficial)
IA_PRECIOS_ARCHIVO=
# Notas de voz (apagado por defecto). Whisper por la capa de proveedores; el audio no se guarda
IA_NOTAS_VOZ=false
IA_AUDIO_MAX_MB=10
IA_AUDIO_MAX_SEGUNDOS=120
GROQ_MODELO_TRANSCRIPCION=whisper-large-v3-turbo
OPENAI_MODELO_TRANSCRIPCION=whisper-1
# Pausa entre casos al evaluar con un proveedor real (plan gratuito de Groq), en ms
EVAL_PAUSA_MS=21000
# Carpeta de resultados de la evaluación (por defecto src/data/evaluaciones)
EVAL_RESULTADOS_DIR=
