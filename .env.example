# Copia este archivo como ".env" y completa cada valor.
# NUNCA subas tu ".env" real al repositorio (ya está en .gitignore).

# ─── Entorno ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# Origen(es) del frontend permitidos por CORS en producción (en desarrollo, CORS va abierto).
# Admite varios separados por coma si hay más de un cliente web (ej. app React + Flutter web),
# ya que cada uno vive en un dominio distinto al backend y las cookies de sesión son cross-site.
FRONTEND_URL=https://edumon-web.vercel.app,https://edumon-flutter-web.example.com

# ─── Base de datos ────────────────────────────────────────────────────────
# Cadena de conexión de MongoDB (local o Atlas)
MONGO_URI=mongodb://localhost:27017/edumon

# ─── Autenticación (JWT) ──────────────────────────────────────────────────
# Secreto para firmar los access tokens. Usa un valor largo y aleatorio
# (ej. `node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"`)
JWT_SECRET=
# Nota: el TTL real del access token (15m) está fijo en src/controllers/authController.js;
# esta variable no se usa actualmente en el código.
JWT_EXPIRES_IN=15m

# ─── Cloudinary (fotos de perfil, portadas, adjuntos) ─────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ─── Firebase Admin SDK (notificaciones push / FCM) ───────────────────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Debe incluir los \n literales de la clave privada entre comillas, ej:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"
FIREBASE_PRIVATE_KEY=

# ─── Web Push (VAPID) — suscripciones push del navegador ─────────────────
# Genera el par de claves con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:tu-correo@ejemplo.com

# ─── Twilio (recuperación de contraseña por WhatsApp) ─────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de WhatsApp Business de Twilio, formato: +14155238886
TWILIO_WHATSAPP_NUMBER=

# ─── Resend (recuperación de contraseña por correo) ───────────────────────
RESEND_API_KEY=
